# Example Brand configuration for local development. Copy to apps/storefront/.env.local.
# No real secret belongs in this file.

# Which Brand in brands/ this deployment serves: atelier (Starter) or kanvas (Enterprise).
BRAND_ID=atelier

# The GetCart enterprise backend's local Shop API (VENDURE_SERVER_PORT=3100).
VENDURE_SHOP_API_URL=http://localhost:3100/shop-api

# The Channel token of this Brand's Channel, from the enterprise dashboard.
VENDURE_CHANNEL_TOKEN=replace-with-channel-token

# Optional: more Channels of the same Brand, chosen by request host only.
# VENDURE_CHANNEL_HOSTS=id.example.com=token-a,sg.example.com=token-b

# Public origin of this storefront. Enterprise's MIDTRANS_RETURN_URL must be
# <SITE_URL>/checkout/return, here http://localhost:3000/checkout/return.
SITE_URL=http://localhost:3000

# Optional CMS. Leave all three unset for a Brand without a CMS. Set all three to turn it on.
# CMS_URL=
# CMS_API_KEY=
# CMS_PREVIEW_SECRET=
